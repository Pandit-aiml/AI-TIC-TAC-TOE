        "import numpy as np\n",
        "import pandas as pd\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.preprocessing.text import Tokenizer\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "\n",
        "df = pd.read_csv(\"COVID19_Hospital_Bed_Dataset_250.csv\")\n",
        "\n",
        "df.columns = df.columns.str.strip()\n",
        "\n",
        "states = df[\"Indian State Name\"].astype(str).tolist()\n",
        "beds = df[\"Available Beds\"].astype(float).values\n",
        "hospitals = df[\"Hospital Name\"].astype(str).tolist()\n",
        "\n",
        "state_tokenizer = Tokenizer()\n",
        "state_tokenizer.fit_on_texts(states)\n",
        "state_seq = state_tokenizer.texts_to_sequences(states)\n",
        "state_seq = pad_sequences(state_seq, maxlen=1)\n",
        "\n",
        "unique_hospitals = sorted(set(hospitals))\n",
        "hospital_index = {h: i for i, h in enumerate(unique_hospitals)}\n",
        "labels = np.array([hospital_index[h] for h in hospitals])\n",
        "\n",
        "num_classes = len(unique_hospitals)\n",
        "\n",
        "beds_min = beds.min()\n",
        "beds_max = beds.max()\n",
        "beds_norm = (beds - beds_min) / (beds_max - beds_min)\n",
        "beds_norm = beds_norm.reshape(-1, 1)\n",
        "\n",
        "state_vocab_size = len(state_tokenizer.word_index) + 1\n",
        "\n",
        "state_input = tf.keras.Input(shape=(1,), name=\"state_input\")\n",
        "bed_input = tf.keras.Input(shape=(1,), name=\"bed_input\")\n",
        "\n",
        "state_embed = tf.keras.layers.Embedding(state_vocab_size, 16)(state_input)\n",
        "state_flat = tf.keras.layers.Flatten()(state_embed)\n",
        "\n",
        "merged = tf.keras.layers.Concatenate()([state_flat, bed_input])\n",
        "\n",
        "dense1 = tf.keras.layers.Dense(32, activation=\"sigmoid\")(merged)\n",
        "\n",
        "output = tf.keras.layers.Dense(num_classes, activation=\"softmax\")(dense1)\n",
        "\n",
        "model = tf.keras.Model(\n",
        "    inputs=[state_input, bed_input],\n",
        "    outputs=output\n",
        ")\n",
        "\n",
        "model.compile(\n",
        "    optimizer=\"adam\",\n",
        "    loss=\"sparse_categorical_crossentropy\",\n",
        "    metrics=[\"accuracy\"]\n",
        ")\n",
        "\n",
        "model.fit(\n",
        "    [state_seq, beds_norm],\n",
        "    labels,\n",
        "    epochs=50,\n",
        "    batch_size=32,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "def recommend_hospital(user_beds, user_state, tolerance=0.15):\n",
        "\n",
        "    state_test = state_tokenizer.texts_to_sequences([user_state])\n",
        "    state_test = pad_sequences(state_test, maxlen=1)\n",
        "\n",
        "    beds_test_norm = (user_beds - beds_min) / (beds_max - beds_min)\n",
        "    beds_test_norm = np.array([[beds_test_norm]])\n",
        "\n",
        "    prediction = model.predict(\n",
        "        [state_test, beds_test_norm],\n",
        "        verbose=0\n",
        "    )\n",
        "\n",
        "    predicted_index = np.argmax(prediction)\n",
        "    predicted_hospital = unique_hospitals[predicted_index]\n",
        "    confidence = prediction[0][predicted_index] * 100\n",
        "\n",
        "    print(\"\\nPredicted Hospital :\", predicted_hospital)\n",
        "    print(\"Confidence : {:.2f}%\".format(confidence))\n",
        "\n",
        "    lower = user_beds * (1 - tolerance)\n",
        "    upper = user_beds * (1 + tolerance)\n",
        "\n",
        "    matches = df[\n",
        "        (df[\"Indian State Name\"].str.lower() == user_state.lower()) &\n",
        "        (df[\"Available Beds\"] >= lower) &\n",
        "        (df[\"Available Beds\"] <= upper)\n",
        "    ]\n",
        "\n",
        "    if matches.empty:\n",
        "        print(\"\\nNo exact hospital found.\")\n",
        "        print(\"Showing nearest hospitals...\\n\")\n",
        "\n",
        "        matches = df[\n",
        "            df[\"Indian State Name\"].str.lower() == user_state.lower()\n",
        "        ].copy()\n",
        "\n",
        "        matches[\"Difference\"] = (\n",
        "            matches[\"Available Beds\"] - user_beds\n",
        "        ).abs()\n",
        "\n",
        "        matches = matches.sort_values(\"Difference\").head(10)\n",
        "        matches = matches.drop(columns=[\"Difference\"])\n",
        "\n",
        "    print(\n",
        "        matches[\n",
        "            [\n",
        "                \"Sr. No.\",\n",
        "                \"Indian State Name\",\n",
        "                \"Hospital Name\",\n",
        "                \"Total Beds\",\n",
        "                \"Available Beds\",\n",
        "                \"COVID-19 Patients\"\n",
        "            ]\n",
        "        ].to_string(index=False)\n",
        "    )\n",
        "\n",
        "    return matches\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    user_beds = float(input(\"Enter Required Beds : \"))\n",
        "    user_state = input(\"Enter State Name : \")\n",
        "    recommend_hospital(user_beds, user_state)"
      ],
